# See the frontend for the AI-provider keys (GROQ_API_KEY, TOGETHER_API_KEY,
# etc.) — this file only documents the login-feature additions.

# ── AI provider (backend/ai_service.py) ───────────────────────────────────────
# "anthropic" is the default and covers every LLM feature in the app --
# analyze_game, explain_position, chat_about_position, kid-mode, profile
# analysis, OCR interpretation, AND /coach -- all on claude-sonnet-5.
# SECURITY NOTE (2026-08): the Together account behind TOGETHER_API_KEY was
# compromised. Do not set AI_PROVIDER=together again until that key has been
# rotated on Together's dashboard (and the old one revoked) AND usage has
# been audited for abuse. Needs only ANTHROPIC_API_KEY below -- no base_url,
# no other provider key required.
AI_PROVIDER=anthropic

# ── Auth / DB (login feature) ─────────────────────────────────────────────────
# Local dev: connects directly to Postgres (no PgBouncer needed for a single
# local process). In any multi-instance deployment, route this through
# PgBouncer instead — see docker-compose.yml (port 6432).
DATABASE_URL=postgresql://chessai:chessai@localhost:5432/chessai
REDIS_URL=redis://localhost:6379/0

# Shared verbatim with frontend/.env.local — verifies the short-lived token
# Next.js mints for calls into this API. Generate with: openssl rand -hex 32
INTERNAL_JWT_SECRET=
# Optional previous secret, for zero-downtime rotation. Leave blank normally.
INTERNAL_JWT_SECRET_PREV=

# Comma-separated Prisma user ids (public.users.id) allowed to view the
# /admin dashboard. Keyed on user id, not email -- username/password signups
# never set an email. Find your id via `psql -d chessai -c "SELECT id, username FROM users"`,
# or just visit /admin signed in as the account you want to grant, which
# echoes your own id back so you can copy it in. Must be set identically
# (same ids) in frontend/.env.local's ADMIN_USER_IDS -- the two checks are
# independent, neither trusts the other.
ADMIN_USER_IDS=

# Comma-separated origins allowed to call this API from the browser (CORS).
# Defaults to the two local dev ports if unset — MUST be set to the real
# frontend origin(s) in any deployed environment, or every browser request
# gets CORS-blocked.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Required for AI_PROVIDER=anthropic above, and unconditionally for /coach's
# open-ended position chat (that feature always uses Claude regardless of
# AI_PROVIDER — it's the app's core differentiator, so accuracy matters more
# than provider uniformity there specifically).
ANTHROPIC_API_KEY=
# claude-sonnet-5 by default; bump to claude-opus-5 here once quality is
# assessed against Sonnet — no code change needed either way. Shared by
# AI_PROVIDER=anthropic's model choice and /coach's dedicated client.
COACH_MODEL=claude-sonnet-5

# ── Stockfish engine pool scaling (see backend/engine_pool.py) ────────────────
# Number of Stockfish processes shared by every analysis endpoint, and the
# hash table size (MB) each one gets. Defaults (1 / 32) match the old
# single-engine behaviour exactly — safe to leave unset.
# STOCKFISH_POOL_SIZE should match real vCPU count — on a single core,
# running more than one engine concurrently doesn't give true parallelism
# (they'd just contend for the same core), so only raise it above 1 once
# hosted on 2+ vCPUs. STOCKFISH_HASH_MB is independent of core count — raise
# it whenever more RAM is available (e.g. 256 on a 2GB instance) for a
# bigger transposition table and faster search at the same depth.
STOCKFISH_POOL_SIZE=1
STOCKFISH_HASH_MB=32
