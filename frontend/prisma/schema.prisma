// Auth.js (NextAuth v5) standard schema + our ChessProfile extension.
// This Prisma schema owns the `public` Postgres schema (users, OAuth account
// links, chess.com/lichess username links). FastAPI owns a separate `app`
// schema (migrated with Alembic, see backend/alembic/) for derived/cache data
// — the two never migrate the same tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime traffic goes through PgBouncer (transaction pooling) so per-instance
  // connection counts don't multiply against Postgres's max_connections as the
  // app scales out horizontally.
  url       = env("DATABASE_URL")
  // Migrations need a direct, non-pooled connection — PgBouncer's transaction
  // mode doesn't support the session-level features (advisory locks, DDL) that
  // `prisma migrate` relies on.
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  // Username/password sign-in, for anyone without a Google account. Both
  // null for OAuth-only users; `password` is always a bcrypt hash, never
  // plaintext.
  username      String?   @unique
  password      String?

  accounts     Account[]
  chessProfile ChessProfile?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// Present for Auth.js Prisma-adapter compatibility. Unused at runtime under
// the `jwt` session strategy (chosen for statelessness / horizontal scale) —
// kept so switching strategies later doesn't require a schema migration.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Optional chess.com / lichess username links, entered post-login. Chess.com
// has no OAuth API, so its username is always hand-typed + validated against
// the public API. Lichess username is auto-populated + verified when the user
// signs in via Lichess OAuth; if hand-typed instead, `lichessVerified` stays
// false.
model ChessProfile {
  userId           String   @id
  lichessUsername  String?  @unique
  chesscomUsername String?  @unique
  lichessVerified  Boolean  @default(false)
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chess_profiles")
}
